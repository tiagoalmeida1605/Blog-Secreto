{
  "name": "nexus-dev-hub",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty",
    "test": "node --test && vitest run",
    "check:api": "node scripts/check-api-syntax.mjs",
    "check": "npm run typecheck && npm run check:api && npm test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
