rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'z2oLd0jzSmfHiwYocDE2pJOmVOn2';
    }

    function validEntry(data) {
      return data.keys().hasAll([
          'title', 'content', 'category', 'favorite', 'archived', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'content', 'category', 'favorite', 'archived', 'createdAt', 'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.content is string
        && data.content.size() > 0
        && data.content.size() <= 200000
        && data.category in ['diary', 'study', 'project', 'idea', 'other']
        && data.favorite is bool
        && data.archived is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /entries/{entryId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && validEntry(request.resource.data)
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() == 24
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() == 24;
      allow update: if isOwner()
        && validEntry(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() == 24;
      allow delete: if isOwner();
    }

    match /devhub_projects/{projectId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasAll([
          'name', 'description', 'category', 'status', 'repository',
          'productionUrl', 'technologies', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'category', 'status', 'repository',
          'productionUrl', 'technologies', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 60
        && request.resource.data.status in ['active', 'planned', 'paused', 'archived']
        && request.resource.data.repository is string
        && request.resource.data.productionUrl is string
        && request.resource.data.technologies is list
        && request.resource.data.technologies.size() <= 20
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() == 24;
      allow update: if isOwner()
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'category', 'status', 'repository',
          'productionUrl', 'technologies', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 60
        && request.resource.data.status in ['active', 'planned', 'paused', 'archived']
        && request.resource.data.repository is string
        && request.resource.data.productionUrl is string
        && request.resource.data.technologies is list
        && request.resource.data.technologies.size() <= 20
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /devhub_settings/{settingsId} {
      allow read: if isOwner() && settingsId == 'owner';
      allow create, update: if isOwner()
        && settingsId == 'owner'
        && request.resource.data.keys().hasAll(['dashboardWidgets', 'visibleIntegrations', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['dashboardWidgets', 'visibleIntegrations', 'updatedAt'])
        && request.resource.data.dashboardWidgets is list
        && request.resource.data.dashboardWidgets.size() <= 5
        && request.resource.data.dashboardWidgets.hasOnly(['integrations', 'projects', 'github', 'deployments', 'rga'])
        && request.resource.data.visibleIntegrations is list
        && request.resource.data.visibleIntegrations.size() <= 4
        && request.resource.data.visibleIntegrations.hasOnly(['github', 'vercel', 'rga', 'firebase'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /devhub_analytics_snapshots/{snapshotId} {
      allow read, write: if false;
    }

    // Nenhuma outra coleção é aberta por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
